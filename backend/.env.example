# Copy to backend/.env and fill in. Never commit the real .env file.
# Connection string from your Postgres host (Neon: add ?sslmode=require)
DATABASE_URL=
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: extra allowed browser origins, comma-separated
ALLOWED_ORIGINS=
